# Inputs for os/build.sh. Sourced by the workflow and the build script.

# Base image: Raspberry Pi OS Lite (trixie, arm64). Bump both lines together.
# Releases: https://downloads.raspberrypi.com/raspios_lite_arm64/images/
BASE_URL=https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2026-10-06/2026-10-06-raspios-trixie-arm64-lite.img.xz
BASE_SHA256=483db18a48da399b5b7022ffae9a07bc6d99daab30e593aedac09b69ff422843

# Extra space added to the root partition for packages and the app image.
# The device grows the partition to the full SD card on first boot anyway.
IMAGE_GROW=1G

# System identity
DEVICE_HOSTNAME=pi-factory
DEVICE_USER=admin
DEVICE_TIMEZONE=UTC
